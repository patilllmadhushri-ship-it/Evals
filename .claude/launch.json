{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stt-eval-studio",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true"
      ],
      "port": 8501,
      "autoPort": false
    },
    {
      "name": "readnet",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-m",
        "readnet.web",
        "--port",
        "8502"
      ],
      "port": 8502,
      "autoPort": false
    }
  ]
}
