# Copy to .env and fill in whichever providers you want to evaluate.
# .env is git-ignored; this template is not. Never put real keys in here.

# --- STT providers -------------------------------------------------------
DEEPGRAM_API_KEY=
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- LLM judge -----------------------------------------------------------
# Required only for the meaning-aware metrics (intent, LLM-WER, semantic).
# Set whichever backend you judge with; the app picks one in step 3.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
