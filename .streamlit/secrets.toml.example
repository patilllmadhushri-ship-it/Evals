# Template for deploying to Streamlit Community Cloud (or any host that
# supports Streamlit secrets). Copy these keys into the host's secrets UI —
# do NOT commit a filled-in secrets.toml; the real one is git-ignored.
#
# Locally you do not need this file at all: .env is read first.

DEEPGRAM_API_KEY = ""
SARVAM_API_KEY = ""
ELEVENLABS_API_KEY = ""
OPENAI_API_KEY = ""
GOOGLE_API_KEY = ""

# The judge, needed for every meaning-aware metric and for the whole
# Prompt-Based Evaluation mode. One of these is enough.
ANTHROPIC_API_KEY = ""
OPENROUTER_API_KEY = ""
APP_PASSCODE = ""
